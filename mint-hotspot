#!/bin/bash
# Point d'accès WiFi sur une interface virtuelle, sans couper la connexion WiFi en cours.
# Lancé via pkexec : n'accepte que "up", "down", "check" ou "list" ; "check" et "list" sont en lecture seule
# et fonctionnent sans root ("list" perd alors les noms d'hôte, dans les bails DHCP racine-only).
CON=mint-hotspot
AP=ap0
IFB=mhifb
CONF=/etc/mint-hotspot.conf
PIDFILE=/run/mint-hotspot-shaper.pid
PIDFILE_IDLE=/run/mint-hotspot-idle.pid

# Extinction automatique : sans aucun appareil associé pendant IDLE_TIMEOUT s, le point d'accès s'éteint.
# Valeurs par défaut, surchargeables par /etc/mint-hotspot.conf (détenu root).
IDLE=1
IDLE_TIMEOUT=120
IDLE_INTERVAL=5

# Valeurs par défaut du plafonnement adaptatif (kbit/s), surchargeables par /etc/mint-hotspot.conf (détenu root).
SHAPER=1
DOWN_MAX=50000
UP_MAX=10000
DOWN_MIN=1000
UP_MIN=1000
PING_TARGET=1.1.1.1
RTT_OFFSET_MS=50
INTERVAL=2
STEP_DOWN=75
STEP_UP=115
OK_CYCLES=5
CONG_CYCLES=30

if [ -f "$CONF" ] && [ -O "$CONF" ]; then
    # shellcheck source=/dev/null
    . "$CONF"
fi

# Trouve la carte WiFi (STA) et vérifie qu'elle accepte une station et un point d'accès en même temps :
# une des « valid interface combinations » de iw doit contenir managed et AP, avec au moins 2 interfaces.
check() {
    STA=$(iw dev | awk -v ap="$AP" '/Interface/ {i = $2} /type managed/ && i != ap {print i; exit}')
    if [ -z "$STA" ]; then
        MSG="Aucune interface WiFi trouvée"
    elif iw phy "$(cat "/sys/class/net/$STA/phy80211/name")" info |
        sed -n '/valid interface combinations/,/^\t[^\t]/p' | tr -d '\n' | tr '*' '\n' |
        grep ' managed[ ,]' | grep ' AP[ ,]' | grep -qE 'total <= ([2-9]|[0-9]{2,})'; then
        return
    else
        MSG="La carte WiFi $STA ne peut pas créer de point d'accès tout en restant connectée"
    fi
    echo "$MSG" >&2
    # En root (pkexec depuis l'extension), pas d'accès au bus de session : c'est l'extension qui notifie.
    [ "$EUID" -eq 0 ] || notify-send -i dialog-error "Point d'accès" "$MSG" 2>/dev/null || true
    return 1
}

# Ajuste les plafonds (kbit/s) des deux sens : ap0 egress = vers les clients, mhifb = envoi des clients.
# quantum 1514 (~MTU) : sinon le kernel avertit "quantum is big" vu r2q=10 par défaut.
shaper_apply() {
    tc class replace dev "$AP" parent 1: classid 1:10 htb rate "${1}kbit" ceil "${1}kbit" quantum 1514
    tc class replace dev "$IFB" parent 1: classid 1:10 htb rate "${2}kbit" ceil "${2}kbit" quantum 1514
}

# Boucle adaptative : on ne réduit le débit des clients que si la latence de l'ordinateur se dégrade,
# on le remonte au calme ; si la congestion persiste au plancher (changement de route, VPN), on recalage le minimum.
shaper_loop() {
    local down=$1 up=$2 best='' rtt ok=0 cong=0 nd nu
    while :; do
        rtt=$(ping -n -c1 -W1 "$PING_TARGET" 2>/dev/null | awk -F'time=' 'NF > 1 {printf "%d", $2}')
        if [ -n "$rtt" ]; then
            [ -z "$best" ] && best=$rtt
            if [ "$rtt" -gt $((best + RTT_OFFSET_MS)) ]; then
                cong=$((cong + 1)); ok=0
                if [ "$down" -le "$DOWN_MIN" ] && [ "$up" -le "$UP_MIN" ]; then
                    [ "$cong" -ge "$CONG_CYCLES" ] && { best=$rtt; cong=0; }
                else
                    down=$((down * STEP_DOWN / 100)); [ "$down" -lt "$DOWN_MIN" ] && down=$DOWN_MIN
                    up=$((up * STEP_DOWN / 100)); [ "$up" -lt "$UP_MIN" ] && up=$UP_MIN
                    shaper_apply "$down" "$up"
                    logger -t mint-hotspot "congestion (rtt ${rtt} ms) : plafonds ${down}kbit/s vers les clients, ${up}kbit/s en envoi"
                fi
            else
                cong=0; ok=$((ok + 1))
                if [ "$ok" -ge "$OK_CYCLES" ]; then
                    ok=0
                    nd=$((down * STEP_UP / 100)); [ "$nd" -gt "$DOWN_MAX" ] && nd=$DOWN_MAX
                    nu=$((up * STEP_UP / 100)); [ "$nu" -gt "$UP_MAX" ] && nu=$UP_MAX
                    if [ "$nd" -gt "$down" ] || [ "$nu" -gt "$up" ]; then
                        down=$nd; up=$nu
                        shaper_apply "$down" "$up"
                        logger -t mint-hotspot "latence normale : plafonds ${down}kbit/s vers les clients, ${up}kbit/s en envoi"
                    fi
                fi
            fi
        fi
        sleep "$INTERVAL"
    done
}

# Arrête le shaper : daemon, qdiscs sur ap0, interface ifb.
shaper_stop() {
    local pid
    if [ -r "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    tc qdisc del dev "$AP" root 2>/dev/null
    tc qdisc del dev "$AP" ingress 2>/dev/null
    ip link del "$IFB" 2>/dev/null
}

# HTB + fq_codel dans les deux sens : le trafic de l'ordinateur (wlo1) n'est jamais touché.
shaper_start() {
    [ "$SHAPER" = 0 ] && return 0

    ip link add "$IFB" type ifb 2>/dev/null
    ip link set "$IFB" up || return 1
    tc qdisc replace dev "$AP" root handle 1: htb default 10
    tc class replace dev "$AP" parent 1: classid 1:10 htb rate "${DOWN_MAX}kbit" ceil "${DOWN_MAX}kbit" quantum 1514
    tc qdisc replace dev "$AP" parent 1:10 fq_codel
    tc qdisc replace dev "$AP" handle ffff: ingress
    tc filter replace dev "$AP" parent ffff: protocol all matchall action mirred egress redirect dev "$IFB"
    tc qdisc replace dev "$IFB" root handle 1: htb default 10
    tc class replace dev "$IFB" parent 1: classid 1:10 htb rate "${UP_MAX}kbit" ceil "${UP_MAX}kbit" quantum 1514
    tc qdisc replace dev "$IFB" parent 1:10 fq_codel

    shaper_loop "$DOWN_MAX" "$UP_MAX" </dev/null >/dev/null 2>&1 &
    echo $! >"$PIDFILE"
    logger -t mint-hotspot "shaper actif : plafonds ${DOWN_MAX}kbit/s vers les clients, ${UP_MAX}kbit/s en envoi"
}

# Éteint le point d'accès : shaper, connexion NetworkManager, interface virtuelle.
ap_down() {
    shaper_stop
    nmcli con down "$CON" >/dev/null 2>&1
    iw dev "$AP" del 2>/dev/null
}

idle_stop() {
    local pid
    if [ -r "$PIDFILE_IDLE" ]; then
        pid=$(cat "$PIDFILE_IDLE" 2>/dev/null)
        # Pas soi-même : le daemon s'arrête après avoir éteint le point d'accès.
        [ -n "$pid" ] && [ "$pid" != "$$" ] && kill "$pid" 2>/dev/null
        rm -f "$PIDFILE_IDLE"
    fi
}

# La veille s'appuie sur les stations associées (iw), que NetworkManager ne suit pas en mode AP :
# un client en veille ou en cours d'association compte et remet le compteur à zéro.
idle_loop() {
    local last now n
    last=$(date +%s)
    while :; do
        n=$(iw dev "$AP" station dump 2>/dev/null | grep -c '^Station ')
        now=$(date +%s)
        if [ "$n" -gt 0 ]; then
            last=$now
        elif [ $((now - last)) -ge "$IDLE_TIMEOUT" ]; then
            logger -t mint-hotspot "aucun appareil connecté depuis ${IDLE_TIMEOUT}s : extinction automatique"
            rm -f "$PIDFILE_IDLE"
            ap_down
            exit 0
        fi
        sleep "$IDLE_INTERVAL"
    done
}

idle_start() {
    [ "$IDLE" = 0 ] && return 0

    idle_loop </dev/null >/dev/null 2>&1 &
    echo $! >"$PIDFILE_IDLE"
    logger -t mint-hotspot "veille active : extinction après ${IDLE_TIMEOUT}s sans appareil connecté"
}

# Durée lisible à partir du "connected time" de iw (secondes) : 3h12m, 45m, 9s.
fmt_dur() {
    local s=${1:-0}
    if [ "$s" -ge 3600 ]; then
        printf '%dh%02dm' "$((s / 3600))" "$(((s % 3600) / 60))"
    elif [ "$s" -ge 60 ]; then
        printf '%dm' "$((s / 60))"
    else
        printf '%ds' "$s"
    fi
}

# Fabricant : bloc "(hex)" du préfixe OUI (24 bits) dans la base IEEE locale.
oui_name() {
    local p=${1:0:8}
    p=${p^^}
    p=${p//:/-}
    awk -v p="$p" '$1 == p && $2 == "(hex)" {
        gsub(/\r/, "") # la base IEEE est en CRLF : sinon le \r finit dans la colonne / le JSON
        for (i = 3; i <= NF; i++) printf "%s%s", $i, (i < NF ? " " : "")
        print ""
        exit
    }' /usr/share/ieee-data/oui.txt 2>/dev/null
}

# Liste les appareils connectés : IP, MAC, durée d'association, nom d'hôte et fabricant.
# iw et l'ARP se lisent sans root ; les bails dnsmasq de NetworkManager (IP + nom d'hôte) sont
# racine-only, d'où le repli sur ip neigh (IP sans nom) quand la commande n'est pas lancée en root.
list() {
    local json=0 out rc ip mac sec host vend first=1 rows=() sorted
    [ "${1:-}" = "-j" ] && json=1

    out=$(iw dev "$AP" station dump 2>/dev/null); rc=$?
    if [ "$rc" -ne 0 ]; then
        if ! iw dev "$AP" info >/dev/null 2>&1; then
            if [ "$json" = 1 ]; then echo '[]'; else echo "Le point d'accès est éteint" >&2; fi
            return 0
        fi
        echo "Lecture des stations impossible sur $AP (droits insuffisants ?)" >&2
        return 1
    fi

    # Bails DHCP : mac -> ip, mac -> nom d'hôte.
    local -A ipmap=() hostmap=() f
    for f in /var/lib/NetworkManager/dnsmasq-*.leases; do
        [ -r "$f" ] || continue
        while read -r _ mac ip host _; do
            mac=${mac,,}
            [ -n "$mac" ] || continue
            ipmap[$mac]=$ip
            [ "$host" != '*' ] && hostmap[$mac]=$host
        done <"$f"
    done

    # ARP (lisible sans root) : ip -> mac, en secours pour les IP sans bail lisible.
    local arp
    arp=$(ip neigh show dev "$AP" 2>/dev/null |
        awk '/lladdr/ {for (i = 1; i <= NF; i++) if ($i == "lladdr") {print $1, $(i + 1); break}}')
    while read -r ip mac; do
        mac=${mac,,}
        [ -n "$mac" ] && [ -z "${ipmap[$mac]:-}" ] && ipmap[$mac]=$ip
    done <<<"$arp"

    while read -r mac sec; do
        [ -n "$mac" ] || continue
        vend=$(oui_name "$mac")
        rows+=("${ipmap[$mac]:--}|$mac|${sec:-0}|${hostmap[$mac]:--}|$vend")
    done < <(printf '%s\n' "$out" | awk '/^Station / {m = $2} /connected time:/ {print m, $3}')

    if [ "${#rows[@]}" -eq 0 ]; then
        if [ "$json" = 1 ]; then echo '[]'; else echo "Aucun appareil connecté"; fi
        return 0
    fi
    sorted=$(printf '%s\n' "${rows[@]}" | sort -t'|' -k1,1V)

    if [ "$json" = 1 ]; then
        printf '['
        while IFS='|' read -r ip mac sec host vend; do
            [ "$first" = 1 ] || printf ','
            first=0
            # guillemets éventuels du nom d'hôte ou du fabricant : on les retire plutôt que d'échapper
            printf '{"ip":"%s","mac":"%s","hostname":"%s","vendor":"%s","seconds":%s}' \
                "${ip//\"/}" "$mac" "${host//\"/}" "${vend//\"/}" "$sec"
        done <<<"$sorted"
        printf ']\n'
    else
        printf '%-15s %-17s %-8s %-18s %s\n' "IP" "MAC" "Durée" "Nom" "Fabricant"
        while IFS='|' read -r ip mac sec host vend; do
            # nom et fabricant tronqués : le tableau reste aligné comme dans le dialogue de l'extension
            printf '%-15s %-17s %-8s %-18.18s %.28s\n' "$ip" "$mac" "$(fmt_dur "$sec")" "$host" "$vend"
        done <<<"$sorted"
    fi
}

case "${1:-}" in
check)
    check && echo "OK : la carte WiFi $STA peut partager sa connexion"
    ;;
up)
    check || exit 1

    # ponytail: canal figé au démarrage ; si la box change de canal en 2,4 GHz, éteindre/rallumer.
    # Hors 2,4 GHz 1-11 (box en 5 GHz) : 6, car en région 00 seul 1-11 autorise un AP.
    CH=$(iw dev "$STA" info | awk '/channel/ {print $2; exit}')
    [[ "$CH" =~ ^([1-9]|1[01])$ ]] || CH=6

    # mac80211 refuse de monter un AP qui a la même MAC que la station (ENOTUNIQ).
    MAC=$(cat "/sys/class/net/$STA/address")
    MAC=$(printf '%02x%s' $((0x${MAC:0:2} ^ 2)) "${MAC:2}")
    iw dev "$AP" info >/dev/null 2>&1 || iw dev "$STA" interface add "$AP" type __ap addr "$MAC" || exit 1

    if ! nmcli con show "$CON" >/dev/null 2>&1; then
        PSK=$(tr -dc 'a-zA-Z0-9' </dev/urandom 2>/dev/null | head -c 12)
        nmcli con add type wifi ifname "$AP" con-name "$CON" autoconnect no mode ap ssid "$(hostname)-hotspot" \
            802-11-wireless.band bg ipv4.method shared \
            wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
            wifi-sec.psk "$PSK" >/dev/null || exit 1
    fi
    nmcli con modify "$CON" 802-11-wireless.channel "$CH"

    # NM met un instant à détecter la nouvelle interface.
    # autoconnect no : si le point d'accès tombe autrement que par "down", ap0 ne se connecte à aucun réseau.
    for _ in 1 2 3 4 5; do
        ERR=$(nmcli con up "$CON" 2>&1 >/dev/null) && {
            nmcli dev set "$AP" autoconnect no
            shaper_stop
            shaper_start
            idle_stop
            idle_start
            exit 0
        }
        sleep 1
    done
    shaper_stop
    iw dev "$AP" del
    echo "$ERR" >&2
    exit 1
    ;;
down)
    idle_stop
    ap_down
    exit 0
    ;;
list)
    list "${2:-}"
    ;;
*)
    echo "usage: $0 up|down|check|list [-j]" >&2
    exit 2
    ;;
esac
