#!/bin/bash
# Point d'accès WiFi sur une interface virtuelle, sans couper la connexion WiFi en cours.
# Lancé en root via pkexec : n'accepte que "up", "down" ou "check" (lecture seule, sans root), aucune autre entrée.
CON=mint-hotspot
AP=ap0

# Trouve la carte WiFi (STA) et vérifie qu'elle accepte une station et un point d'accès en même temps :
# une des « valid interface combinations » de iw doit contenir managed et AP, avec au moins 2 interfaces.
check() {
    STA=$(iw dev | awk -v ap="$AP" '/Interface/ {i = $2} /type managed/ && i != ap {print i; exit}')
    if [ -z "$STA" ]; then
        MSG="Aucune interface WiFi trouvée"
    elif iw phy "$(cat "/sys/class/net/$STA/phy80211/name")" info |
        sed -n '/valid interface combinations/,/^\t[^\t]/p' | tr -d '\n' | tr '*' '\n' |
        grep ' managed[ ,]' | grep ' AP[ ,]' | grep -qE 'total <= ([2-9]|[0-9]{2,})'; then
        return
    else
        MSG="La carte WiFi $STA ne peut pas créer de point d'accès tout en restant connectée"
    fi
    echo "$MSG" >&2
    # En root (pkexec depuis l'extension), pas d'accès au bus de session : c'est l'extension qui notifie.
    [ "$EUID" -eq 0 ] || notify-send -i dialog-error "Point d'accès" "$MSG" 2>/dev/null || true
    return 1
}

case "${1:-}" in
check)
    check && echo "OK : la carte WiFi $STA peut partager sa connexion"
    ;;
up)
    check || exit 1

    # ponytail: canal figé au démarrage ; si la box change de canal en 2,4 GHz, éteindre/rallumer.
    # Hors 2,4 GHz 1-11 (box en 5 GHz) : 6, car en région 00 seul 1-11 autorise un AP.
    CH=$(iw dev "$STA" info | awk '/channel/ {print $2; exit}')
    [[ "$CH" =~ ^([1-9]|1[01])$ ]] || CH=6

    # mac80211 refuse de monter un AP qui a la même MAC que la station (ENOTUNIQ).
    MAC=$(cat "/sys/class/net/$STA/address")
    MAC=$(printf '%02x%s' $((0x${MAC:0:2} ^ 2)) "${MAC:2}")
    iw dev "$AP" info >/dev/null 2>&1 || iw dev "$STA" interface add "$AP" type __ap addr "$MAC" || exit 1

    if ! nmcli con show "$CON" >/dev/null 2>&1; then
        PSK=$(tr -dc 'a-zA-Z0-9' </dev/urandom 2>/dev/null | head -c 12)
        nmcli con add type wifi ifname "$AP" con-name "$CON" autoconnect no mode ap ssid "$(hostname)-hotspot" \
            802-11-wireless.band bg ipv4.method shared \
            wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
            wifi-sec.psk "$PSK" >/dev/null || exit 1
    fi
    nmcli con modify "$CON" 802-11-wireless.channel "$CH"

    # NM met un instant à détecter la nouvelle interface.
    # autoconnect no : si le point d'accès tombe autrement que par "down", ap0 ne se connecte à aucun réseau.
    for _ in 1 2 3 4 5; do
        ERR=$(nmcli con up "$CON" 2>&1 >/dev/null) && { nmcli dev set "$AP" autoconnect no; exit 0; }
        sleep 1
    done
    iw dev "$AP" del
    echo "$ERR" >&2
    exit 1
    ;;
down)
    nmcli con down "$CON" >/dev/null 2>&1
    iw dev "$AP" del 2>/dev/null
    exit 0
    ;;
*)
    echo "usage: $0 up|down|check" >&2
    exit 2
    ;;
esac
